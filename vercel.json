{
  "version": 2,
  "builds": [
    {
      "src": "dashain-wish.html",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/dashain-wish.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}